<Project Sdk="Microsoft.NET.Sdk.Razor">
    <!-- Package-only consumer: PackageReferences to InfiniFrame and to the external CEF provider. No ProjectReference
         to InfiniFrame or provider source, no friend access, no reflection, no copied assemblies. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <AssemblyName>Contoso.CefHostConsumer</AssemblyName>
        <RootNamespace>Contoso.CefHostConsumer</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="InfiniLore.InfiniFrame.Application" Version="$(InfiniFrameVersion)" />
        <PackageReference Include="InfiniLore.InfiniFrame.BlazorWebView" Version="$(InfiniFrameVersion)" />
        <PackageReference Include="Ceffortless" Version="[$(ContosoCefHostVersion)]" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    </ItemGroup>
    <ItemGroup>
        <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
