@implements IAsyncDisposable
@inject IJSRuntime JS
@inject FakeLoginService Login

<dialog @ref="_parent" class="lc-dialog" aria-labelledby="lc-dialog-title" aria-describedby="lc-dialog-description">
    <div class="lc-dialog-drag" data-drag-handle><div><div class="lc-eyebrow">IN-PAGE DIALOG · DRAG HERE</div><h2 id="lc-dialog-title">Local sign-in</h2></div><button type="button" aria-label="Close sign-in" @onclick="CloseAsync">×</button></div>
    <div class="lc-dialog-content">
        <p id="lc-dialog-description">Fake credentials: <strong>operator / demo</strong>. No account or network is used.</p>
        <form @onsubmit="SignInAsync" @onsubmit:preventDefault>
            <label for="lc-user">User name<input id="lc-user" autocomplete="off" @bind="_user" autofocus /></label>
            <label for="lc-password">Demo password<input id="lc-password" type="password" autocomplete="off" @bind="_password" /></label>
            <div class="lc-dialog-actions"><button type="submit" class="lc-primary" disabled="@_busy">@(_busy ? "Checking…" : "Check fake login")</button><button type="button" @onclick="ShowConfirmationAsync">Open confirmation</button></div>
        </form>
        <p class="lc-login-result" role="status">@_status</p>
        <p class="lc-hint">Escape or Close cancels pending work. The background stays blocked while a dialog is open.</p>
    </div>
</dialog>
<dialog @ref="_confirmation" class="lc-dialog lc-confirm" aria-labelledby="lc-confirm-title" aria-describedby="lc-confirm-description">
    <div class="lc-dialog-content">
        <div class="lc-eyebrow">NESTED CONFIRMATION</div><h2 id="lc-confirm-title">Confirm local action?</h2>
        <p id="lc-confirm-description">This only records an acknowledgement in the parent dialog. No hardware is connected.</p>
        <div class="lc-dialog-actions"><button class="lc-primary" type="button" @onclick="ConfirmAsync">Confirm</button><button type="button" @onclick="KeepEditingAsync" autofocus>Keep editing</button></div>
    </div>
</dialog>

@code {
    private ElementReference _parent;
    private ElementReference _confirmation;
    private IJSObjectReference? _module;
    private IJSObjectReference? _dialogs;
    private DotNetObjectReference<ControlDialog>? _self;
    private CancellationTokenSource? _loginCancellation;
    private Task? _initialization;
    private Task? _opening;
    private Task? _pendingLogin;
    private string _user = "operator";
    private string _password = "";
    private string _status = "Ready for a local credential check.";
    private bool _busy;
    private bool _disposed;
    private bool _openingOrOpen;
    private long _attempt;
    private long _dialogGeneration;
    private long _nextDialogGeneration;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return firstRender ? _initialization = InitializeAsync() : Task.CompletedTask;
    }

    private async Task InitializeAsync()
    {
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/LocalControlsUi/local-controls.js");
        if (_disposed) return;
        _self = DotNetObjectReference.Create(this);
        _dialogs = await _module.InvokeAsync<IJSObjectReference>("createDialogs", _parent, _confirmation, _self);
    }

    public Task ShowAsync()
    {
        if (_disposed) return Task.CompletedTask;
        if (_opening is { IsCompleted: false }) return _opening;
        if (_openingOrOpen) return Task.CompletedTask;
        // Claim the operation before initialization or any other await can yield to another click.
        _openingOrOpen = true;
        return _opening = OpenAsync();
    }

    private async Task OpenAsync()
    {
        try
        {
            if (_initialization is not null) await _initialization;
            if (_disposed) return;
            if (_dialogs is null) { _openingOrOpen = false; return; }
            await CancelLoginAsync();
            if (_disposed) return;
            var generation = _dialogGeneration = ++_nextDialogGeneration;
            _user = "operator";
            _password = "";
            _status = "Ready for a local credential check.";
            await InvokeAsync(StateHasChanged);
            if (_disposed) return;
            var acceptedGeneration = await _dialogs.InvokeAsync<long>("showParent", generation);
            // A close callback can arrive before the interop acknowledgement. Never reopen its state.
            if (!_disposed && _openingOrOpen && _dialogGeneration == generation)
            {
                _dialogGeneration = acceptedGeneration;
                _openingOrOpen = acceptedGeneration != 0;
            }
        }
        catch (Exception openException)
        {
            _openingOrOpen = false;
            _dialogGeneration = 0;
            await CancelLoginAsync();
            // If JS opened the dialog before the call failed, retire that opening before retrying.
            if (!_disposed && _dialogs is not null)
            {
                try { await _dialogs.InvokeVoidAsync("closeParent"); }
                catch (Exception closeException)
                {
                    throw new AggregateException("Opening and retiring the local dialog failed.", openException, closeException);
                }
            }
            throw;
        }
    }

    private Task SignInAsync()
    {
        if (_busy || _disposed || !_openingOrOpen) return Task.CompletedTask;
        return _pendingLogin = CheckCredentialsAsync();
    }

    private async Task CheckCredentialsAsync()
    {
        var attempt = ++_attempt;
        var cancellation = new CancellationTokenSource();
        _loginCancellation = cancellation;
        _busy = true;
        _status = "Checking fake credentials…";
        try
        {
            var accepted = await Login.AcceptAsync(_user, _password, cancellation.Token);
            if (!_disposed && attempt == _attempt)
                _status = accepted ? "Accepted by the fake backend." : "Rejected by the fake backend. Try operator / demo.";
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        finally
        {
            if (attempt == _attempt) { _busy = false; _loginCancellation = null; }
            cancellation.Dispose();
        }
    }

    private async Task CancelLoginAsync()
    {
        _attempt++;
        var pending = _pendingLogin;
        _loginCancellation?.Cancel();
        _loginCancellation = null;
        _busy = false;
        _password = "";
        if (pending is not null) await pending;
        if (ReferenceEquals(_pendingLogin, pending)) _pendingLogin = null;
    }

    [JSInvokable]
    public Task ParentClosedAsync(long generation)
    {
        if (_disposed || !_openingOrOpen || generation != _dialogGeneration) return Task.CompletedTask;
        return InvokeAsync(async () =>
        {
            if (_disposed || !_openingOrOpen || generation != _dialogGeneration) return;
            _openingOrOpen = false;
            _dialogGeneration = 0;
            await CancelLoginAsync();
            if (_disposed || _openingOrOpen) return;
            _status = "Pending work cancelled. Dialog closed.";
            StateHasChanged();
        });
    }

    private async Task CloseAsync()
    {
        await CancelLoginAsync();
        if (_dialogs is not null) await _dialogs.InvokeVoidAsync("closeParent");
    }

    private async Task ShowConfirmationAsync()
    {
        if (_dialogs is not null) await _dialogs.InvokeVoidAsync("showConfirmation");
    }

    private async Task ConfirmAsync()
    {
        _status = "Local action acknowledged. Nothing was sent to a device.";
        await KeepEditingAsync();
    }

    private async Task KeepEditingAsync()
    {
        if (_dialogs is not null) await _dialogs.InvokeVoidAsync("closeConfirmation");
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _openingOrOpen = false;
        _dialogGeneration = 0;
        try
        {
            await CancelLoginAsync();
            if (_initialization is not null) await _initialization;
            if (_opening is not null) await _opening;
        }
        catch (JSDisconnectedException) { /* The host already retired this document's JS context. */ }
        finally
        {
            try
            {
                if (_dialogs is not null)
                {
                    await _dialogs.InvokeVoidAsync("dispose");
                    await _dialogs.DisposeAsync();
                }
                if (_module is not null) await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* No live document remains to release. */ }
            finally { _self?.Dispose(); }
        }
    }
}
